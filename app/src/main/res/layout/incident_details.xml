<?xml version="1.0" encoding="utf-8"?>
<!-- A tapped 511 incident: what, where, when, then the agency's own notes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <Button
        style="@style/TakwerxButton"
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/incident_kind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incident_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incident_where"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <!-- A message sign, drawn as the sign looks across the pane's full width
                 (LedSignView, added in code: a plugin class named in a layout is
                 resolved against ATAK's class loader, not ours). -->
            <FrameLayout
                android:id="@+id/incident_sign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/incident_when"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/incident_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textColor="@color/heading_yellow"
                android:textSize="14sp" />

            <!-- The agency's unit updates, as CHP's own incident page lists them. -->
            <TextView
                android:id="@+id/incident_units_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:paddingTop="14dp"
                android:text="@string/incident_units"
                android:textAllCaps="true"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/incident_units"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/incident_details_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:paddingTop="14dp"
                android:text="@string/incident_notes"
                android:textAllCaps="true"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/incident_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/incident_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:paddingTop="14dp"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
